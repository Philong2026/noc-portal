PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/noc_automation
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
GRAFANA_URL=https://your-grafana-instance.example.com
GRAFANA_TOKEN=replace-with-grafana-token
# Optional: direct browser -> Grafana mode for src/mockApi.js (grafanaApi).
# When unset, the app uses the backend proxy above (recommended; token stays server-side).
VITE_GRAFANA_URL=https://your-grafana-instance.example.com
VITE_GRAFANA_TOKEN=replace-with-grafana-token
